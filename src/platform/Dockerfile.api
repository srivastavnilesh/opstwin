FROM python:3.12-slim

# 1. System deps (libgomp for XGBoost, curl for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Python deps
COPY requirements-serving.txt .
# Use --no-cache-dir to keep image small; retries handle network flakiness
RUN pip install --no-cache-dir --retries 5 -r requirements-serving.txt

# 3. App code
COPY config.py .
COPY src/ src/

EXPOSE 8000

# CRITICAL FIX: Use 'python -m' to ensure the module is found
CMD ["python", "-m", "uvicorn", "src.serving.api:app", "--host", "0.0.0.0", "--port", "8000"]